# Tawk.to live chat — same integration style as zamratech.com.
# Dashboard: https://dashboard.tawk.to → Admin → Channels → Widget → Direct chat link → copy embed URL (format below).
NEXT_PUBLIC_TAWK_EMBED_SRC=

# Contact form email — Gmail SMTP
# CONTACT_EMAIL = the address that receives form submissions
# SMTP_USER     = Gmail address used to send (usually same as CONTACT_EMAIL)
# SMTP_PASS     = Gmail App Password (NOT your normal password)
#   → Generate at: https://myaccount.google.com/apppasswords
#   → Requires 2-Step Verification enabled on the Google account
CONTACT_EMAIL=info@360websolutions.co.uk
SMTP_USER=info@360websolutions.co.uk
SMTP_PASS=

# Google Business Profile reviews (optional dynamic homepage reviews)
# GOOGLE_MAPS_API_KEY = Google Cloud API key with Places API enabled
# GOOGLE_PLACE_ID     = GBP place id (example: ChIJf4s6m8YEdkgRrW0h0oO5Dq8)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=ChIJf4s6m8YEdkgRrW0h0oO5Dq8

# WordPress blog (REST API)
# WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json
# WORDPRESS_IMAGE_HOST=your-wordpress-site.com
WORDPRESS_API_URL=https://goldenrod-lion-234427.hostingersite.com/wp-json
WORDPRESS_IMAGE_HOST=goldenrod-lion-234427.hostingersite.com
